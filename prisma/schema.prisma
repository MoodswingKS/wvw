// Prisma schema — targets Supabase Postgres.
// DATABASE_URL comes from your Supabase project's connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  LOBBY
  NIGHT
  DAY
  VOTING
  ENDED
}

enum Role {
  VILLAGER
  WEREWOLF
  SEER
  DOCTOR
  // add more roles here as you design them (hunter, witch, etc.)
}

enum ActionType {
  KILL      // werewolf night kill
  INVESTIGATE // seer check
  PROTECT   // doctor save
}

enum RoleMode {
  AUTO   // role deck is scaled from player count automatically
  MANUAL // host specifies how many of each role, rest fill as Villager
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  createdAt DateTime @default(now())

  memberships RoomMembership[]
  hostedRooms Room[]           @relation("RoomHost")
}

model Room {
  id           String     @id @default(cuid())
  code         String     @unique // short join code, e.g. "FOX419"
  status       RoomStatus @default(LOBBY)
  dayNumber    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Set by the host at creation. Applies to every night/day phase —
  // each phase gets this many seconds before it needs resolving.
  roundSeconds Int      @default(3600)
  // When the current phase's countdown ends. Null in LOBBY/ENDED.
  phaseEndsAt  DateTime?

  // AUTO: role deck is scaled from player count (see buildRoleDeck).
  // MANUAL: host sets counts per role in roleCounts before starting;
  // sky's the limit on how many roles get added later (50+ planned) —
  // this stays a flexible map rather than named columns.
  roleMode     RoleMode @default(AUTO)
  roleCounts   Json?    // e.g. {"WEREWOLF": 2, "SEER": 1, "DOCTOR": 1}

  hostId       String
  host         User       @relation("RoomHost", fields: [hostId], references: [id])

  memberships  RoomMembership[]
  votes        Vote[]
  nightActions NightAction[]
}

// One row per player-in-a-room; keeps room-specific state
// (role, alive status) separate from the persistent User identity.
model RoomMembership {
  id       String  @id @default(cuid())
  role     Role?
  isAlive  Boolean @default(true)
  isHost   Boolean @default(false)
  joinedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  votesCast    Vote[]        @relation("VoterMembership")
  votesAgainst Vote[]        @relation("TargetMembership")
  actionsBy    NightAction[] @relation("ActorMembership")
  actionsOn    NightAction[] @relation("TargetOfAction")

  @@unique([userId, roomId])
}

model Vote {
  id        String   @id @default(cuid())
  dayNumber Int
  createdAt DateTime @default(now())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  voterId String
  voter   RoomMembership @relation("VoterMembership", fields: [voterId], references: [id])

  targetId String
  target   RoomMembership @relation("TargetMembership", fields: [targetId], references: [id])

  @@unique([roomId, dayNumber, voterId]) // one vote per player per day
}

model NightAction {
  id         String     @id @default(cuid())
  actionType ActionType
  dayNumber  Int
  createdAt  DateTime   @default(now())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  actorId String
  actor   RoomMembership @relation("ActorMembership", fields: [actorId], references: [id])

  targetId String
  target   RoomMembership @relation("TargetOfAction", fields: [targetId], references: [id])
}
